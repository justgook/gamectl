<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bulletml SYSTEM "../bulletml.dtd">
<bulletml type="vertical">
  <bullet label="red">
    <data>
      <color>#FF3333</color>
      <sprite>bullet/red</sprite>
    </data>
  </bullet>
  <bullet label="green">
    <data>
      <color>#33FF66</color>
      <sprite>bullet/green</sprite>
    </data>
  </bullet>
  <bullet label="blue">
    <data>
      <color>#4488FF</color>
      <sprite>bullet/blue</sprite>
    </data>
  </bullet>
  <bullet label="gold">
    <data>
      <color>#FFD24A</color>
      <sprite>bullet/gold</sprite>
    </data>
  </bullet>
  <action label="top">
    <repeat>
      <times>12</times>
      <action>
        <fire>
          <direction type="sequence">30</direction>
          <speed type="absolute">2.0</speed>
          <bulletRef label="red"/>
        </fire>
        <fire>
          <direction type="sequence">30</direction>
          <speed type="absolute">2.2</speed>
          <bulletRef label="green"/>
        </fire>
        <fire>
          <direction type="sequence">30</direction>
          <speed type="absolute">2.4</speed>
          <bulletRef label="blue"/>
        </fire>
        <fire>
          <direction type="sequence">30</direction>
          <speed type="absolute">2.6</speed>
          <bulletRef label="gold"/>
        </fire>
        <wait>5</wait>
      </action>
    </repeat>
  </action>
</bulletml>
