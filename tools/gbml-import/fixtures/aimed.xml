<?xml version="1.0" encoding="UTF-8"?>
<bulletml type="vertical">
  <fire label="aimedShot">
    <direction type="aim">0</direction>
    <speed type="absolute">1.5+$rank</speed>
    <bullet>
      <action>
        <changeSpeed>
          <speed type="relative">0.5</speed>
          <term>60</term>
        </changeSpeed>
        <wait>120</wait>
        <vanish/>
      </action>
    </bullet>
  </fire>
  <action label="top">
    <repeat>
      <times>5</times>
      <action>
        <fireRef label="aimedShot"/>
        <wait>12+$rand*12</wait>
      </action>
    </repeat>
  </action>
</bulletml>
