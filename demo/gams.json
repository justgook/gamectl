      "memory": {
        "import": true,
        "shared": true,
        "initialPages": 288,
        "maximumPages": 512
      }
    },
    {
      "id": "ai.provider.mock",
      "runtime": "js",
      "role": "service",
      "url": "builtin/plugins/ai_provider_mock/index.js"
