  "ui": {
    "keys": [
      {
        "key": "mod+s",
        "script": "demo/keys/save-active-view.lua",
        "allowInput": true
      },
      {
        "key": "escape",
        "call": [
          "activeView.id",
          "clearSelection",
          "{}"
        ]
      },
      {
        "key": "mod+r",
        "call": [
          "activeView.id",
          "run",
          "{}"
        ]
      }
    ]
  },
  "plugins": [
    {
      "id": "sql",
      "runtime": "wasm",
      "role": "service",
      "url": "builtin/plugins/sql-vec.wasm"
    },
    {
      "id": "random",
      "runtime": "wasm",
      "role": "service",
      "url": "builtin/plugins/random.wasm"
    },
    {
      "id": "scaler",
      "runtime": "wasm",
      "role": "service",
