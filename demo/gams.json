  "ui": {
    "keys": [
      {
        "key": "mod+s",
        "script": "demo/keys/save-active-view.lua",
        "allowInput": true
      },
      {
        "key": "escape",
        "call": [
          "activeView.id",
          "clearSelection",
          "{}"
        ]
      },
      {
        "key": "mod+r",
        "call": [
          "activeView.id",
          "run",
          "{}"
        ]
      }
    ],
