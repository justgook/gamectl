package gams:app@1.0.0;

/// App host world used by the Tauri bootstrap runtime.
///
/// `gams:runtime/runtime` is first-party and lives in `/wit/runtime`.
/// WASI filesystem WIT should be fetched with wkg into this folder when we
/// start generating bindings from WIT, e.g.:
///
///   cd cmd/app
///   wkg wit fetch wasi:filesystem@0.2.0 --wit-dir wit
///
/// For the Rust host MVP we use wasmtime-wasi's predefined WASIp2 linker
/// implementation instead of generated bindings, so this file is currently the
/// source-of-truth declaration rather than generated code input.
world app-host {
  import gams:runtime/runtime@1.0.0;

  import wasi:filesystem/types@0.2.0;
  import wasi:filesystem/preopens@0.2.0;
}
