{
  "color-semantic": {
    "$type": "color",
    "$description": "Semantic color tokens - use these in components, not the global colors directly",
    "background": {
      "default": {
        "$value": "{color.black}",
        "$description": "Main application background"
      },
      "panel": {
        "$value": "{color.grey-900}",
        "$description": "Panel/card background"
      },
      "panel-header": {
        "$value": "{color.grey-800}",
        "$description": "Panel header background"
      },
      "interactive-hover": {
        "$value": "{color.grey-700}",
        "$description": "Hover state for interactive elements"
      },
      "interactive-active": {
        "$value": "{color.black}",
        "$description": "Active/pressed state"
      },
      "accent-default": {
        "$value": "{color.cyan-500}",
        "$description": "Primary accent background"
      },
      "accent-hover": {
        "$value": "{color.cyan-300}",
        "$description": "Accent hover state"
      },
      "danger": {
        "$value": "{color.red-500}",
        "$description": "Danger/error background"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.cyan-100}",
        "$description": "Primary text color"
      },
      "secondary": {
        "$value": "{color.cyan-300}",
        "$description": "Secondary/muted text"
      },
      "accent": {
        "$value": "{color.cyan-500}",
        "$description": "Accent/highlighted text"
      },
      "on-accent": {
        "$value": "{color.black}",
        "$description": "Text on accent backgrounds"
      },
      "danger": {
        "$value": "{color.red-500}",
        "$description": "Error/danger text"
      },
      "placeholder": {
        "$value": "{color.grey-700}",
        "$description": "Placeholder text in inputs"
      }
    },
    "border": {
      "default": {
        "$value": "{color.grey-800}",
        "$description": "Default border color"
      },
      "interactive": {
        "$value": "{color.cyan-500}",
        "$description": "Interactive element borders"
      },
      "danger": {
        "$value": "{color.red-500}",
        "$description": "Error state borders"
      }
    },
    "focus-ring": {
      "default": {
        "$value": "{shadow.glow-accent}",
        "$type": "shadow",
        "$description": "Focus indicator for interactive elements"
      }
    }
  }
}