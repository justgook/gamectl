{
  "list": {
    "$description": "List component tokens",
    "item": {
      "padding-v": {
        "$value": "{spacing.scale-3}",
        "$type": "dimension"
      },
      "padding-h": {
        "$value": "{spacing.scale-4}",
        "$type": "dimension"
      },
      "background": {
        "hover": {
          "$value": "{color-semantic.background.interactive-hover}",
          "$type": "color"
        }
      },
      "border": {
        "color": {
          "$value": "{color-semantic.border.default}",
          "$type": "color"
        },
        "width": {
          "$value": "{border.width.default}",
          "$type": "dimension"
        }
      }
    }
  }
}
