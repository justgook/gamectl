{
  "file-tree": {
    "$description": "File tree component tokens",
    "background": {
      "$value": "{color-semantic.background.panel}",
      "$type": "color"
    },
    "font-size": {
      "$value": "{font.size.sm}",
      "$type": "dimension"
    },
    "item": {
      "padding-v": {
        "$value": "{spacing.scale-2}",
        "$type": "dimension"
      },
      "padding-h": {
        "$value": "{spacing.scale-3}",
        "$type": "dimension"
      },
      "indent": {
        "$value": "{spacing.scale-5}",
        "$type": "dimension",
        "$description": "Indentation per nesting level"
      },
      "text": {
        "$type": "color",
        "default": {
          "$value": "{color-semantic.text.primary}"
        },
        "hover": {
          "$value": "{color-semantic.text.accent}"
        }
      },
      "background": {
        "$type": "color",
        "hover": {
          "$value": "{color-semantic.background.interactive-hover}"
        },
        "selected": {
          "$value": "{color.grey-700}"
        }
      },
      "icon": {
        "color": {
          "$value": "{color-semantic.text.secondary}",
          "$type": "color"
        }
      }
    }
  }
}
