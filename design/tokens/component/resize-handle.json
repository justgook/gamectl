{
  "resize-handle": {
    "$description": "Resize handle component for split layouts",
    "background": {
      "$value": "{color-semantic.border.default}",
      "$type": "color",
      "$description": "Subtle structural color that matches panel hierarchy"
    },
    "box-shadow": {
      "$value": "none",
      "$type": "shadow",
      "$description": "No glow by default - keeps handles subtle"
    },
    "size": {
      "interaction": {
        "$value": "{spacing.scale-4}",
        "$type": "dimension",
        "$description": "Interaction area using scale-4 (12px)"
      },
      "visual": {
        "$value": "{spacing.scale-1}",
        "$type": "dimension",
        "$description": "Visual thickness using scale-1 (2px)"
      }
    },
    "hover": {
      "$description": "Hover state for resize handles",
      "background": {
        "$value": "rgba(0, 229, 255, 0.2)",
        "$type": "color",
        "$description": "Subtle cyan hint on hover - not overwhelming"
      },
      "box-shadow": {
        "$value": "{shadow.glow-accent-faint}",
        "$type": "shadow",
        "$description": "Gentle glow, not strong accent glow"
      }
    },
    "active": {
      "$description": "Active state for resize handles",
      "background": {
        "$value": "rgba(0, 229, 255, 0.4)",
        "$type": "color",
        "$description": "More visible when dragging but not full accent"
      },
      "box-shadow": {
        "$value": "{shadow.glow-accent}",
        "$type": "shadow",
        "$description": "Standard glow for feedback"
      }
    },
    "vertical": {
      "$description": "Vertical resize handle variant",
      "cursor": {
        "$value": "ew-resize",
        "$type": "cursor"
      }
    },
    "horizontal": {
      "$description": "Horizontal resize handle variant",
      "cursor": {
        "$value": "ns-resize",
        "$type": "cursor"
      }
    }
  }
}