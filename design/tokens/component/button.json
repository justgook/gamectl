{
  "button": {
    "$description": "Button component tokens",
    "padding-v": {
      "$value": "{spacing.scale-3}",
      "$type": "dimension"
    },
    "padding-h": {
      "$value": "{spacing.scale-5}",
      "$type": "dimension"
    },
    "border-radius": {
      "$value": "{border.radius.sm}",
      "$type": "dimension"
    },
    "font": {
      "$value": "{font-semantic.body.default}",
      "$type": "typography"
    },
    "primary": {
      "$description": "Primary button variant",
      "background": {
        "$type": "color",
        "default": {
          "$value": "{color-semantic.background.accent-default}"
        },
        "hover": {
          "$value": "{color-semantic.background.accent-hover}"
        }
      },
      "text": {
        "$value": "{color-semantic.text.on-accent}",
        "$type": "color"
      },
      "border": {
        "$value": "transparent",
        "$type": "color"
      }
    },
    "secondary": {
      "$description": "Secondary button variant",
      "background": {
        "$type": "color",
        "default": {
          "$value": "transparent"
        },
        "hover": {
          "$value": "{color-semantic.background.interactive-hover}"
        }
      },
      "text": {
        "$value": "{color-semantic.text.accent}",
        "$type": "color"
      },
      "border": {
        "$value": "{color-semantic.border.interactive}",
        "$type": "color"
      }
    }
  }
}
