{
  "font": {
    "$description": "Base font properties",
    "family": {
      "$type": "fontFamily",
      "ui": {
        "$value": "Roboto, sans-serif",
        "$description": "Primary UI font"
      },
      "display": {
        "$value": "Orbitron, sans-serif",
        "$description": "Display/heading font with tech aesthetic"
      }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "11px" },
      "sm": { "$value": "12px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "20px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "$description": "Unitless line height multipliers",
      "default": { "$value": 1.5 },
      "compact": { "$value": 1.2 }
    }
  }
}
