package gams:runtime@1.0.0;

interface runtime {
  /// Dynamic call from a WASM component to the host runtime.
  ///
  /// If `target` resolves to a loaded WASM component export, the runtime invokes
  /// that export directly. Component targets use the same invocation shape as the
  /// frontend runtime: `package/interface::function`, for example
  /// `fs/fs::read-text`. Fully-qualified WIT interface names such as
  /// `gams:fs/fs::read-text` are also accepted for component calls.
  ///
  /// For component calls, `args` is a JSON array matching the target function's
  /// parameters. The returned string is the JSON-encoded invocation result using
  /// the same shape as frontend `runtime.invoke`, including WIT result values as
  /// `{ "ok": ... }` or `{ "err": ... }`.
  ///
  /// If `target` does not resolve to a component export, the runtime forwards the
  /// call to the frontend view bridge. In that case `target` and `args` are owned
  /// by the frontend protocol; JSON is the recommended initial encoding.
  call: func(target: string, args: string) -> result<string, string>;
}

world imports {
  import runtime;
}
