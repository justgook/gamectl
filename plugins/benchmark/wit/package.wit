package gams:benchmark@1.0.0;

interface benchmark {
    flags sample-flags {
        read,
        write,
        execute,
    }

    enum sample-enum {
        alpha,
        beta,
        gamma,
    }

    record sample-record {
        name: string,
        count: u32,
        enabled: bool,
    }

    variant sample-variant {
        none,
        text(string),
        number(u32),
    }

    record fs-report {
        preopen-count: u32,
        first-preopen: string,
        entry-count: u32,
        first-entry: option<string>,
    }

    echo-bool: func(value: bool) -> bool;
    echo-s8: func(value: s8) -> s8;
    echo-u8: func(value: u8) -> u8;
    echo-s16: func(value: s16) -> s16;
    echo-u16: func(value: u16) -> u16;
    echo-s32: func(value: s32) -> s32;
    echo-u32: func(value: u32) -> u32;
    echo-s64: func(value: s64) -> s64;
    echo-u64: func(value: u64) -> u64;
    echo-f32: func(value: f32) -> f32;
    echo-f64: func(value: f64) -> f64;
    echo-char: func(value: char) -> char;
    echo-string: func(value: string) -> string;
    echo-enum: func(value: sample-enum) -> sample-enum;
    echo-flags: func(value: sample-flags) -> sample-flags;
    echo-list-u8: func(value: list<u8>) -> list<u8>;
    echo-list-string: func(value: list<string>) -> list<string>;
    echo-record: func(value: sample-record) -> sample-record;
    echo-tuple: func(value: tuple<string, u32, bool>) -> tuple<string, u32, bool>;
    echo-option: func(value: option<string>) -> option<string>;
    echo-result: func(value: result<u32, string>) -> result<u32, string>;
    echo-variant: func(value: sample-variant) -> sample-variant;

    /// Calls gams:runtime/runtime.call directly. This exists to build deadlock
    /// tests around synchronous WASM -> frontend view calls.
    call-runtime-view: func(target: string, args: string) -> result<string, string>;

    /// Exercises wasi:filesystem from inside a component.
    check-wasi-filesystem: func(path: string) -> result<fs-report, string>;
}

world benchmark-plugin {
    import gams:runtime/runtime@1.0.0;
    import wasi:filesystem/types@0.2.0;
    import wasi:filesystem/preopens@0.2.0;

    export benchmark;
}
