{
  "ui": {
    "keys": [
      {
        "key": "mod+s",
        "script": "keys/save-active-view.lua",
        "allowInput": true
      },
      {
        "key": "escape",
        "script": "keys/escape.lua",
        "allowInput": false
      },
      {
        "key": "1",
        "call": ["activeView.tool_1"]
      },
      {
        "key": "2",
        "call": ["activeView.tool_2"]
      },
      {
        "key": "3",
        "call": ["activeView.tool_3"]
      },
      {
        "key": "4",
        "call": ["activeView.tool_4"]
      },
      {
        "key": "5",
        "call": ["activeView.tool_5"]
      },
      {
        "key": "6",
        "call": ["activeView.tool_6"]
      },
      {
        "key": "=",
        "call": ["activeView.zoomIn"]
      },
      {
        "key": "-",
        "call": ["activeView.zoomOut"]
      },
      {
        "key": "0",
        "call": ["activeView.zoomFit"]
      },
      {
        "key": "f",
        "call": ["activeView.zoomFit"]
      },
      {
        "key": "o",
        "call": ["activeView.open"]
      },
      {
        "key": "r",
        "call": ["activeView.reload"]
      },
      {
        "key": "n",
        "call": ["activeView.new"],
        "allowInput": false
      },
      {
        "key": "mod+shift+s",
        "call": ["activeView.saveAs"],
        "allowInput": true
      }
    ],
    "services": {
      "ui-layout": {
        "url": "ui-plugins/layout.js",
        "config": {
          "layout": "<view-tilemap />"
        }
      }
    },

    "views": {
      "view-issues": {
        "url": "views/view-issues.js",
        "label": "Issues",
        "group": "Project",
        "internal": false,
        "config": {
          "defaultSource": "issues",
          "open": "view-markdow",
          "filter": {
            "status": ["yonking", "open", "in-progress", "done"],
            "tags": ["idea", "plugin", "view"]
          },
          "sort": {
            "status": ["open", "in-progress", "done"],
            "mtime": "dsc",
            "ctime": "asc",
            "atime": "dsc"
          },
          "dnd": ["status:*"]
        }
      },
      "view-animation": {
        "url": "views/view-animation.js",
        "label": "Animation",
        "group": "TODO",
        "internal": false
