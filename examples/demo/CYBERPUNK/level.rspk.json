{
  "package": "main",
  "odin": {
    "package": "data_level",
    "imports": {
      "world": "../world"
    }
  },
  "data": ["Atlas", "Segments", "Platformer_Zones", "Positions"],
  "types": {
    "iVec4": {
      "type": "array",
      "len": 4,
      "value": "i32"
    },
    "EntityIds": {
      "type": "vector",
      "value": "u32"
    },
    "world.Position": {
      "type": "array",
      "len": 2,
      "value": "i32"
    },
    "Positions": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Position"
        }
      }
    },
    "Atlas": {
      "type": "bytes"
    },
    "world.Platformer_Zone_Kind": {
      "type": "enum",
      "value": ["Ladder", "Water"]
    },
    "world.Platformer_Zone": {
      "type": "struct",
      "fields": {
        "id": "string",
        "kind": "world.Platformer_Zone_Kind",
        "bounds": "iVec4"
      }
    },
    "Platformer_Zones": {
      "type": "vector",
      "value": "world.Platformer_Zone"
    },
    "Segments": {
      "type": "vector",
      "value": "iVec4"
    }
  }
}
