{
  "package": "main",
  "odin": {
    "package": "data_level",
    "imports": {
      "director": "../director",
      "shape": "../world/shape",
      "world": "../world"
    }
  },
  "data": [
    "Atlas",
    "Segments",
    "Platformer_Zones",
    "Positions",
    "Director_Trigger_Aabbs",
    "Director_Entities",
    "Next_Entity_Id",
    "Brains",
    "Inputs",
    "Velocities",
    "Colliders",
    "Player_Hurts",
    "Platformers",
    "Sprites",
    "Platformer_Anim_Refs",
    "Bullet_Refs",
    "Tilemaps"
  ],
  "types": {
    "Next_Entity_Id": "u32",
    "world.Brain": "i8",
    "Input_Value": "u8",
    "world.Velocity": {
      "type": "array",
      "len": 2,
      "value": "i32"
    },
    "shape.Capsule": {
      "type": "struct",
      "fields": {
        "x": {
          "type": "i32",
          "default": 0
        },
        "y": {
          "type": "i32",
          "default": 0
        },
        "radius": "i32",
        "height": "i32"
      }
    },
    "world.Platformer": {
      "type": "struct",
      "fields": {
        "facing": "i32"
      }
    },
    "Vec2f": {
      "type": "array",
      "len": 2,
      "value": "f32"
    },
    "Vec4f": {
      "type": "array",
      "len": 4,
      "value": "f32"
    },
    "world.Sprite": {
      "type": "struct",
      "fields": {
        "pos": {
          "type": "Vec2f",
          "default": [0, 0]
        },
        "opacity": {
          "type": "f32",
          "default": 1
        }
      }
    },
    "Brains": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Brain"
        }
      }
    },
    "Inputs": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "Input_Value"
        }
      }
    },
    "Velocities": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Velocity"
        }
      }
    },
    "Colliders": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "shape.Capsule"
        }
      }
    },
    "Player_Hurts": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "shape.Capsule"
        }
      }
    },
    "Platformers": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Platformer"
        }
      }
    },
    "world.Platformer_Anim_Ref": {
      "type": "struct",
      "fields": {
        "atlas_base_id": "u32"
      }
    },
    "Platformer_Anim_Refs": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Platformer_Anim_Ref"
        }
      }
    },
    "world.Bullet_Side": {
      "type": "enum",
      "value": ["Player", "Enemy"]
    },
    "world.Bullet_Ref": {
      "type": "struct",
      "fields": {
        "pattern_id": "u32",
        "side": "world.Bullet_Side"
      }
    },
    "Bullet_Refs": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Bullet_Ref"
        }
      }
    },
    "Sprites": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Sprite"
        }
      }
    },
    "iVec4": {
      "type": "array",
      "len": 4,
      "value": "i32"
    },
    "EntityIds": {
      "type": "vector",
      "value": "u32"
    },
    "world.Position": {
      "type": "array",
      "len": 2,
      "value": "i32"
    },
    "Positions": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Position"
        }
      }
    },
    "director.Entity_Id": "u32",
    "world.Director_Trigger_Aabb": {
      "type": "struct",
      "fields": {
        "bounds": "iVec4",
        "once": "bool",
        "used": "bool"
      }
    },
    "world.Director_Entity": {
      "type": "struct",
      "fields": {
        "id": "director.Entity_Id"
      }
    },
    "Director_Trigger_Aabbs": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Director_Trigger_Aabb"
        }
      }
    },
    "Director_Entities": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Director_Entity"
        }
      }
    },
    "Atlas": {
      "type": "bytes"
    },
    "world.Platformer_Zone_Kind": {
      "type": "enum",
      "value": ["Ladder", "Water"]
    },
    "world.Platformer_Zone": {
      "type": "struct",
      "fields": {
        "id": "string",
        "kind": "world.Platformer_Zone_Kind",
        "bounds": "iVec4"
      }
    },
    "Platformer_Zones": {
      "type": "vector",
      "value": "world.Platformer_Zone"
    },

    "world.Tilemap": {
      "type": "struct",
      "fields": {
        "tile_size": "Vec2f",
        "tileset_uv": "Vec4f",
        "lut_uv": "Vec4f",
        "parallax": "Vec2f",
        "repeat": "Vec2f"
      }
    },

    "Tilemaps": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Tilemap"
        }
      }
    },
    "Segments": {
      "type": "vector",
      "value": "iVec4"
    }
  }
}
