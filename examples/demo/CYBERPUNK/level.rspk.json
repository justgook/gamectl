{
  "package": "main",
  "odin": {
    "package": "data_level",
    "imports": {
      "director": "../director",
      "world": "../world"
    }
  },
  "data": [
    "Atlas",
    "Segments",
    "Platformer_Zones",
    "Positions",
    "Director_Trigger_Aabbs",
    "Director_Entities",
    "Next_Entity_Id"
  ],
  "types": {
    "Next_Entity_Id": "u32",
    "iVec4": {
      "type": "array",
      "len": 4,
      "value": "i32"
    },
    "EntityIds": {
      "type": "vector",
      "value": "u32"
    },
    "world.Position": {
      "type": "array",
      "len": 2,
      "value": "i32"
    },
    "Positions": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Position"
        }
      }
    },
    "director.Entity_Id": "u32",
    "world.Director_Trigger_Aabb": {
      "type": "struct",
      "fields": {
        "bounds": "iVec4",
        "once": "bool",
        "used": "bool"
      }
    },
    "world.Director_Entity": {
      "type": "struct",
      "fields": {
        "id": "director.Entity_Id"
      }
    },
    "Director_Trigger_Aabbs": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Director_Trigger_Aabb"
        }
      }
    },
    "Director_Entities": {
      "type": "struct",
      "fields": {
        "entity_ids": "EntityIds",
        "components": {
          "type": "vector",
          "value": "world.Director_Entity"
        }
      }
    },
    "Atlas": {
      "type": "bytes"
    },
    "world.Platformer_Zone_Kind": {
      "type": "enum",
      "value": ["Ladder", "Water"]
    },
    "world.Platformer_Zone": {
      "type": "struct",
      "fields": {
        "id": "string",
        "kind": "world.Platformer_Zone_Kind",
        "bounds": "iVec4"
      }
    },
    "Platformer_Zones": {
      "type": "vector",
      "value": "world.Platformer_Zone"
    },
    "Segments": {
      "type": "vector",
      "value": "iVec4"
    }
  }
}
